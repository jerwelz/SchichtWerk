@page "/"
@using SchichtWerk.Domain
@using SchichtWerk.Web.Formatting

<PageTitle>SchichtWerk — Produktionsverluste verstehen</PageTitle>

@* Temporary page: shows the calculated baseline until the dashboard is built in Milestone 4. *@
<main class="placeholder">
    <h1>SchichtWerk</h1>
    <p>Wie Stillstand und Ausschuss die Produktion verändern. <strong>Fiktive Schichtsimulation</strong> — im Aufbau.</p>

    <dl>
        <dt>OEE (Gesamtanlageneffektivität)</dt>
        <dd>@GermanFormat.Percent(result.Oee ?? 0)</dd>
        <dt>Gutteile</dt>
        <dd>@GermanFormat.Number(result.GoodCount) Stück</dd>
        <dt>Stillstand</dt>
        <dd>@GermanFormat.Minutes(result.DowntimeTime)</dd>
        <dt>Ausschussquote</dt>
        <dd>@GermanFormat.Percent(result.RejectShare ?? 0)</dd>
    </dl>
</main>

@code {
    private readonly OeeResult result = OeeCalculator.Calculate(DemoScenarioFactory.CreateBaseline());
}
