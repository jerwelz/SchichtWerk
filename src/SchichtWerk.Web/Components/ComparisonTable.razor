@* Baseline versus current scenario, every value from the domain results. *@

<div class="table-fit">
<table class="table comparison">
    <caption class="visually-hidden">Ausgangslage und aktuelles Szenario im Vergleich</caption>
    <thead>
        <tr><th scope="col">Kennzahl</th><th scope="col">Ausgangs&shy;lage</th><th scope="col">Szenario</th><th scope="col">Änderung</th></tr>
    </thead>
    <tbody>
        @Row("OEE", Changed(Change.OeeChange), GermanFormat.Percent(Baseline.Oee), GermanFormat.Percent(Current.Oee), GermanFormat.PercentagePoints(Change.OeeChange, abbreviated: true))
        @Row("Verfügbarkeit", Changed(Change.AvailabilityChange), GermanFormat.Percent(Baseline.Availability), GermanFormat.Percent(Current.Availability), GermanFormat.PercentagePoints(Change.AvailabilityChange, abbreviated: true))
        @Row("Leistung", Changed(Change.PerformanceChange), GermanFormat.Percent(Baseline.Performance), GermanFormat.Percent(Current.Performance), GermanFormat.PercentagePoints(Change.PerformanceChange, abbreviated: true))
        @Row("Qualität", Changed(Change.QualityChange), GermanFormat.Percent(Baseline.Quality), GermanFormat.Percent(Current.Quality), GermanFormat.PercentagePoints(Change.QualityChange, abbreviated: true))
        @Row("Produziert", Change.TotalCountChange != 0, GermanFormat.Number(Baseline.TotalCount), GermanFormat.Number(Current.TotalCount), GermanFormat.Signed(Change.TotalCountChange))
        @Row("Gutteile", Change.GoodCountChange != 0, GermanFormat.Number(Baseline.GoodCount), GermanFormat.Number(Current.GoodCount), GermanFormat.Signed(Change.GoodCountChange))
        @Row("Ausschuss", Change.RejectedCountChange != 0, GermanFormat.Number(Baseline.RejectedCount), GermanFormat.Number(Current.RejectedCount), GermanFormat.Signed(Change.RejectedCountChange))
        @Row("Laufzeit", Change.RunningTimeChange != TimeSpan.Zero, GermanFormat.Minutes(Baseline.RunningTime), GermanFormat.Minutes(Current.RunningTime), GermanFormat.SignedMinutes(Change.RunningTimeChange))
        @Row("Stillstand", Change.DowntimeChange != TimeSpan.Zero, GermanFormat.Minutes(Baseline.DowntimeTime), GermanFormat.Minutes(Current.DowntimeTime), GermanFormat.SignedMinutes(Change.DowntimeChange))
    </tbody>
</table>
</div>
<p class="muted small table-note">Pp. = Prozentpunkte, die Differenz zweier Prozentwerte.</p>

@code {
    [Parameter, EditorRequired] public required OeeResult Baseline { get; set; }
    [Parameter, EditorRequired] public required OeeResult Current { get; set; }
    [Parameter, EditorRequired] public required ResultComparison Change { get; set; }

    /// <summary>A ratio changed if the difference is defined and not zero (undefined ratios are shown as "–").</summary>
    private static bool Changed(double? change) => change is { } c && c != 0;

    /// <summary>One table row. <paramref name="changed"/> comes from the numeric values; the strings are display only.</summary>
    private static RenderFragment Row(string label, bool changed, string baseline, string current, string change) => __builder =>
    {
        <tr class="@(changed ? "is-changed" : "")">
            <th scope="row">@label</th>
            <td>@baseline</td>
            <td>@current</td>
            <td class="@(changed ? "strong" : "muted")">@change</td>
        </tr>
    };
}
