@* Signed change versus the baseline, marked as better/worse with a word, not only with colour. *@

@if (Show)
{
    var rounded = Math.Round(Value ?? 0, 1);
    var tone = rounded == 0 ? "same" : (rounded > 0) == HigherIsBetter ? "better" : "worse";
    <p class="change change-@tone">
        @Text <span class="change-note">@(tone switch { "better" => "besser", "worse" => "schlechter", _ => "unverändert" }) als Ausgangslage</span>
    </p>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public double? Value { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public bool HigherIsBetter { get; set; }
}
